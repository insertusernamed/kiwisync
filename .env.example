# The vault folder the hub owns. KiwiSync keeps its git history inside it, in .git.
KIWISYNC_VAULT=/home/danielhost/Vaults/Accounting
# Device list and sync bookkeeping.
KIWISYNC_DATA=/home/danielhost/kiwisync/data
# The address devices use, as reached through the reverse proxy.
KIWISYNC_URL=https://example.duckdns.org/kiwisync
KIWISYNC_HOST=127.0.0.1
KIWISYNC_PORT=7025
KIWISYNC_HUB_NAME="Mini PC"
KIWISYNC_MAX_FILE_MB=200
